# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

Function: move_player(current_room, direction)
 
IF current_room = 'Great Hall' THEN
IF direction = 'North' THEN
current_room = 'Dungeon'
ELSE IF direction = 'South' THEN
current_room = 'Bedroom'
ELSE IF direction = 'East' THEN
current_room = 'Kitchen'
ELSE IF direction = 'West' THEN
current_room = 'Library'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Dungeon' THEN
IF direction = 'South' THEN
current_room = 'Great Hall'
ELSE IF direction = 'East' THEN
current_room = 'Gallery'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Gallery' THEN
IF direction = 'West' THEN
current_room = 'Dungeon'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Library' THEN
IF direction = 'East' THEN
current_room = 'Great Hall'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Kitchen' THEN
IF direction = 'West' THEN
current_room = 'Great Hall'
ELSE IF direction = 'North' THEN
current_room = 'Dining Room'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Dining Room' THEN
IF direction = 'South' THEN
current_room = 'Kitchen'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Bedroom' THEN
IF direction = 'North' THEN
current_room = 'Great Hall'
ELSE IF direction = 'East' THEN
current_room = 'Cellar'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
IF current_room = 'Cellar' THEN
IF direction = 'West' THEN
current_room = 'Bedroom'
ELSE
OUTPUT 'Invalid direction'
END IF
END IF
 
RETURN current_room
 
End Function
